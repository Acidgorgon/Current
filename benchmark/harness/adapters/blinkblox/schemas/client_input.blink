-- BlinkBlox copy of adapters/blink/schemas/client_input.blink (same types; inbound limits raised).
-- client_input: every client streams its input each frame (Unreliable) and
-- occasionally sends a reliable gameplay action.
option ClientOutput = "@CLIENT_OUTPUT@"
option ServerOutput = "@SERVER_OUTPUT@"

-- BlinkBlox bounds inbound (client -> server) traffic by default: 8192 bytes
-- and 64 events a packet, 256 instances, 65536 bytes a second per player.
-- Raised exactly as BlinkBlox's own benchmark/definitions/*.blink raise them,
-- so the benchmark measures the work and not refusals (the harness runs
-- frames far faster than 30 Hz of wall-clock time, which a per-second
-- budget would otherwise throttle).
option MaxPacketSize = 2097152
option MaxEventsPerPacket = 2048
option MaxInstancesPerPacket = 2048
option InboundBytesPerSecond = 1073741824
option InboundBurst = 1073741824

set Buttons = { Sprint, Shoot, Pass, Tackle, Jump, Dive }
enum ActionKind = { Shoot, Pass, Tackle, Header, Emote }

struct InputFrame {
    Seq: u8,
    Dir: vector,
    Buttons: Buttons
}

struct Action {
    Kind: ActionKind,
    Target: u16,
    Power: f32
}

event Input {
    From: Client,
    Type: Unreliable,
    Call: SingleSync,
    Data: InputFrame
}

event PlayerAction {
    From: Client,
    Type: Reliable,
    Call: ManyAsync,
    Data: Action
}
