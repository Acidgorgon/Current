-- BlinkBlox copy of adapters/blink/schemas/match_state.blink (same types; inbound limits raised).
-- match_state: the 30 Hz authoritative match snapshot of a 22-player football
-- match, broadcast to every client. Sent both as a Reliable and as an
-- Unreliable event (the driver picks one per scenario variant).
option ClientOutput = "@CLIENT_OUTPUT@"
option ServerOutput = "@SERVER_OUTPUT@"

-- BlinkBlox bounds inbound (client -> server) traffic by default: 8192 bytes
-- and 64 events a packet, 256 instances, 65536 bytes a second per player.
-- Raised exactly as BlinkBlox's own benchmark/definitions/*.blink raise them,
-- so the benchmark measures the work and not refusals (the harness runs
-- frames far faster than 30 Hz of wall-clock time, which a per-second
-- budget would otherwise throttle).
option MaxPacketSize = 2097152
option MaxEventsPerPacket = 2048
option MaxInstancesPerPacket = 2048
option InboundBytesPerSecond = 1073741824
option InboundBurst = 1073741824

enum Phase = { Warmup, Kickoff, Play, Goal, HalfTime, FullTime }
enum Stance = { Idle, Jogging, Sprinting, Dribbling, Tackling, Diving }

struct PlayerState {
    Id: u16,
    Pos: vector<f32>,
    Vel: vector<f16>,
    Stamina: u8,
    State: Stance
}

struct MatchState {
    Ball: vector<f32>,
    Clock: f32,
    HomeScore: u8,
    AwayScore: u8,
    Phase: Phase,
    Players: PlayerState[0..32]
}

event MatchReliable {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: MatchState
}

event MatchUnreliable {
    From: Server,
    Type: Unreliable,
    Call: SingleSync,
    Data: MatchState
}
