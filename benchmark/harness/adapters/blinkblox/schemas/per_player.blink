-- BlinkBlox copy of adapters/blink/schemas/per_player.blink (same types; inbound limits raised).
-- per_player: small reliable events addressed to one player at a time
-- (Fire(player, ...)), five different event types per player per frame.
option ClientOutput = "@CLIENT_OUTPUT@"
option ServerOutput = "@SERVER_OUTPUT@"

-- BlinkBlox bounds inbound (client -> server) traffic by default: 8192 bytes
-- and 64 events a packet, 256 instances, 65536 bytes a second per player.
-- Raised exactly as BlinkBlox's own benchmark/definitions/*.blink raise them,
-- so the benchmark measures the work and not refusals (the harness runs
-- frames far faster than 30 Hz of wall-clock time, which a per-second
-- budget would otherwise throttle).
option MaxPacketSize = 2097152
option MaxEventsPerPacket = 2048
option MaxInstancesPerPacket = 2048
option InboundBytesPerSecond = 1073741824
option InboundBurst = 1073741824

struct InventoryDelta {
    Item: u16,
    Count: u8
}

set Flags = { Muted, Spectating, Captain, Ready, Away, Premium }

struct Boost {
    Kind: u8,
    Duration: f32?,
    Source: u16?
}

event Wallet {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u32
}

event Notify {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: string(0..64)
}

event Inventory {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: InventoryDelta[0..16]
}

event PlayerFlags {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: Flags
}

event BoostApplied {
    From: Server,
    Type: Reliable,
    Call: ManySync,
    Data: Boost
}
