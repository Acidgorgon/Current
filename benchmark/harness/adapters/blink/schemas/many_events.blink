-- many_events: 120 declared server->client reliable events with small payloads.
-- Traffic is spread across the whole index range to expose receive dispatch cost.
-- Generated: for i in 1..120: data = (u8, u16) if i % 3 == 0 else u16;
-- call = SingleSync if i is odd else ManySync.
option ClientOutput = "@CLIENT_OUTPUT@"
option ServerOutput = "@SERVER_OUTPUT@"

event E001 { From: Server, Type: Reliable, Call: SingleSync, Data: u16 }
event E002 { From: Server, Type: Reliable, Call: ManySync, Data: u16 }
event E003 { From: Server, Type: Reliable, Call: SingleSync, Data: (u8, u16) }
event E004 { From: Server, Type: Reliable, Call: ManySync, Data: u16 }
event E005 { From: Server, Type: Reliable, Call: SingleSync, Data: u16 }
