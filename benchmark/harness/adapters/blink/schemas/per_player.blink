-- per_player: small reliable events addressed to one player at a time
-- (Fire(player, ...)), five different event types per player per frame.
option ClientOutput = "@CLIENT_OUTPUT@"
option ServerOutput = "@SERVER_OUTPUT@"

struct InventoryDelta {
    Item: u16,
    Count: u8
}

set Flags = { Muted, Spectating, Captain, Ready, Away, Premium }

struct Boost {
    Kind: u8,
    Duration: f32?,
    Source: u16?
}

event Wallet {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: u32
}

event Notify {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: string(0..64)
}

event Inventory {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: InventoryDelta[0..16]
}

event PlayerFlags {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: Flags
}

event BoostApplied {
    From: Server,
    Type: Reliable,
    Call: ManySync,
    Data: Boost
}
