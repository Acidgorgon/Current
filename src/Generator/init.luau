--> Sync: whether this side listens to a Sync event on the channel (needs yield validation)
--> Order: the shuffled wire indexes (ShuffleEventIds), or nil for declaration order
type Channel = { Count: number, Listening: boolean, Sync: boolean, Order: { number }? }
local Channels: { [string]: Channel } = {
	Reliable = { Count = 0, Listening = false, Sync = false, Order = nil },
	Unreliable = { Count = 0, Listening = false, Sync = false, Order = nil },
}

--> The wire index of the channel's next event or function. With ShuffleEventIds the
--> declaration order goes through a fixed permutation (see ShuffleOrder).
local function NextIndex(Channel: Channel): number
	local Order = Channel.Order
	if Order then
		return Order[Channel.Count + 1]
	end
	return Channel.Count
end

--> FNV-1a (32 bit), continuing from Hash
local function HashText(Text: string, Hash: number): number
	for Index = 1, #Text do
		Hash = bit32.bxor(Hash, string.byte(Text, Index))
		Hash = (bit32.lshift(Hash, 24) + Hash * 403) % 4294967296
	end
	return Hash
end

--> A deterministic permutation of 0 .. Count - 1 (Fisher-Yates driven by xorshift32). The seed
--> is the schema's token hash, so a schema always compiles to the same indexes and they move
--> only when the schema (or EventIdSeed) changes. This is obscurity, not security: it breaks
--> scripts that hardcode "byte N = event X" across schema changes and nothing more.
local function ShuffleOrder(Count: number, SchemaHash: number, Seed: string, ChannelName: string): { number }
	local State = HashText(ChannelName .. "\0" .. Seed, SchemaHash)
	if State == 0 then
		State = 0x9E3779B9
	end

	local function Next(): number
		State = bit32.bxor(State, bit32.lshift(State, 13))
		State = bit32.bxor(State, bit32.rshift(State, 17))
		State = bit32.bxor(State, bit32.lshift(State, 5))
		return State
	end

	local Order = table.create(Count)
	for Index = 1, Count do
		Order[Index] = Index - 1
	end

	for Index = Count, 2, -1 do
		local Other = Next() % Index + 1
		Order[Index], Order[Other] = Order[Other], Order[Index]
	end

	return Order
end

local Types = Prefabs.Types
local Primitives = Prefabs.Primitives
local Structures = Prefabs.Structures

local function IsValidIdentifier(Identifier: string): boolean
	return Identifier:match("%a%w*") == Identifier
end

local function FormatKey(Key: string): string
	if not IsValidIdentifier(Key) then
		return `["{Key}"]`
	end
	return Key
end

local function FormatIndex(Index: string): string
	if not IsValidIdentifier(Index) then
		return `["{Index}"]`
	end
	return `.{Index}`
end

local ENUM_TABLE_THRESHOLD = 4

--> One pair of constant lookup tables per distinct enum, emitted once per file
local function GetEnumTables(Enums: { string }): (string, string)
	local Key = table.concat(Enums, "\0")
	local Existing = EnumTables[Key]
	if Existing then
		return Existing.Read, Existing.Write
	end

	local Id = EnumTableCount
	EnumTableCount += 1

	local ReadName, WriteName = `ENUM_READ_{Id}`, `ENUM_WRITE_{Id}`
	local ReadEntries, WriteEntries = {}, {}
	for Index, EnumItem in Enums do
		table.insert(ReadEntries, `"{EnumItem}"`)
		table.insert(WriteEntries, `[\"{EnumItem}\"] = {Index - 1}`)
	end

	--> Kept inside one table so large IDLs do not run into the 200 local limit
	Constants.Push(`EnumTables[{Id * 2}] = table.freeze(\{{table.concat(ReadEntries, ", ")}\})`)
	Constants.Push(`EnumTables[{Id * 2 + 1}] = table.freeze(\{{table.concat(WriteEntries, ", ")}\})`)

	EnumTables[Key] = { Read = `EnumTables[{Id * 2}]`, Write = `EnumTables[{Id * 2 + 1}]` }
	return `EnumTables[{Id * 2}]`, `EnumTables[{Id * 2 + 1}]`
end

--> Whether a decoded value of this type is a table (the types reuse can recycle)
local function IsTableType(Declaration: Type): boolean
	local Kind = Declaration.Type
	if Kind == "Optional" then
		return IsTableType((Declaration :: Parser.Optional).Value.Of)
	end
	return Kind == "Struct" or Kind == "Array" or Kind == "Map" or Kind == "Set" or Kind == "TagEnum"
end

--> A struct whose fields hold no nested struct, array, map or tagged enum, and few enough of
--> them to keep in registers
local function IsFlatStruct(Declaration: Parser.Struct): boolean
	local Fields = Declaration.Value.Values
	if #Fields == 0 or #Fields > 32 then
		return false
	end
	for _, Field in Fields do
		local Of = Field :: Type
		if Of.Type == "Optional" then
			Of = (Of :: Parser.Optional).Value.Of
		end
		if Of.Type ~= "Primitive" and Of.Type ~= "Enum" and Of.Type ~= "Set" then
			return false
		end
	end
	return true
end

--> Whether a decoded value of this type can be nil (array items of such types can leave holes)
local function CanBeNil(Declaration: Type): boolean
	if Declaration.Type == "Optional" then
		return true
	elseif Declaration.Type == "Primitive" then
		local Kind = (Declaration :: Parser.Primitive).Tokens.Primitive.Value
		return Kind == "Instance" or Kind == "unknown"
	end
	return false
end

--> Whether reuse mode keeps a spare list for tables of this type. Not for tagged enums: a
--> spare of another variant could not be used, so the list would only grow.
local function UsesSpares(Declaration: Type): boolean
	local Kind = Declaration.Type
	return Kind == "Struct" or Kind == "Array" or Kind == "Map" or Kind == "Set"
end

--> Reuse mode: Variable takes the table at Source.Get or, when there is none (or Guard holds), a
--> spare or a new one from Constructor, which is stored into Source.Set. Struct fields are
--> decoded in place (Get == Set == Variable).
local function ReuseTable(Read: Blocks.Block, Variable: string, Source: Source, Constructor: string, Guard: string?)
	local Condition = `not {Variable}{Guard and ` or {Guard}` or ""}`
	local New = if Source.Spare and not Guard then `table.remove({Source.Spare}) or {Constructor}` else Constructor
	if Source.Get ~= Variable then
		Read:Line(`{Read:Declare(Variable)} = {Source.Get}`)
	end
	Read:Line(`if {Condition} then`)
	Read:Line(`{Variable} = {New}`, Read.Indent + 1)
	if Source.Set and Source.Set ~= Variable then
		Read:Line(`{Source.Set} = {Variable}`, Read.Indent + 1)
	end
	Read:Line("end")
end

--> The Source of a nested table decoded in place, at a struct field
local function InPlace(Variable: string): Source
	return { Get = Variable, Set = Variable }
end

local function IsFieldAccess(Variable: string): boolean
	return string.find(Variable, "[%.%[]") ~= nil
end

local function BitIndexToHex(Index: number): string
	return `0x{string.format("%x", 2 ^ Index)}`
end

--> Declaration functions

function Declarations.Primitive(
	Declaration: Parser.Primitive,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string
)
	local Tokens = Declaration.Tokens
	local Primitive = Tokens.Primitive.Value
	local Generator = Primitives[Primitive]
	Generator.Generate(Declaration, Variable, Read, Write, Options.WriteValidations)
end

function Declarations.Set(
	Declaration: Parser.Set,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string,
	Source: Source?
)
	local Value = Declaration.Value
	local Flags = Value.Values

	do
		--> Read Flags: a constant constructor (one allocation, keys pre-sized), every flag is overwritten
		local Template = {}
		for _, Flag in Flags do
			table.insert(Template, `{FormatKey(Flag)} = false`)
		end
		local Constructor = `\{{table.concat(Template, ", ")}\}`
		if Source then
			ReuseTable(Read, Variable, Source, Constructor)
		else
			Read:Line(`{Read:Declare(Variable)} = {Constructor}`)
		end

		local Remaining = #Flags
		local FlagIndex = 1

		while Remaining > 0 do
			local Partition = math.min(Remaining, 32)
			Prefabs.GetTypeToUseByBits(Partition).Read("SET_BITS", Read)

			for Index = 1, Partition do
				local Flag = Flags[FlagIndex]

				Read:EmptyDeclare(Flag)
				Read:Line(`{Variable}{FormatIndex(Flag)} = bit32.btest(SET_BITS, {BitIndexToHex(Index - 1)});`)

				FlagIndex += 1
			end

			Remaining -= Partition
		end
	end

	do
		--> Write body

		local Remaining = #Flags
		local FlagIndex = 1

		while Remaining > 0 do
			local Partition = math.min(Remaining, 32)
			Write:Line(`{Write:Declare("SET_BITS")} = 0`)

			for Index = 1, Partition do
				local Flag = Flags[FlagIndex]
				Write:Line(`if {Variable}{FormatIndex(Flag)} == true then SET_BITS += {BitIndexToHex(Index - 1)} end`)
				FlagIndex += 1
			end

			Prefabs.GetTypeToUseByBits(Partition).Write("SET_BITS", Write)

			Remaining -= Partition
		end
	end
end

function Declarations.Enum(Declaration: Parser.Enum, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local Value = Declaration.Value
	local Enums = Value.Values
	local Literal = Util.GenerateEnumLiterals(Enums)
	Literal = string.gsub(Literal, "|", "or")

	--> Small enums: comparison chains. Larger enums: constant lookup tables.
	if #Enums > ENUM_TABLE_THRESHOLD then
		local ReadTable, WriteTable = GetEnumTables(Enums)
		Types.u8.Read(`Index`, Read)

		--> Inside a loop, the lookup table is fetched once into a local at the top of the function
		local Root, InLoop = Read, false
		while Root.Parent do
			InLoop = InLoop or Root.Unique ~= "BLOCK_START"
			Root = Root.Parent
		end
		if InLoop then
			local Local = string.gsub(ReadTable, "EnumTables%[(%d+)%]", "EnumRead_%1")
			if not Root.Variables[Local] then
				Root.Variables[Local] = true
				Root:_lineFront(`local {Local} = {ReadTable}`)
			end
			ReadTable = Local
		end

		if IsFieldAccess(Variable) then
			--> Checked in a local, so the field is written once and not read back
			Read:Line(`{Read:Declare("EnumValue")} = {ReadTable}[Index + 1]`)
			Read:Compare("EnumValue", "nil", "Equals"):Line(`error(\`Unexpected enum: \{Index\}\`)`):End()
			Read:Line(`{Variable} = EnumValue :: any`)
		else
			Read:Line(`{Read:Declare(Variable)} = {ReadTable}[Index + 1] :: any`)
			Read:Compare(Variable, "nil", "Equals"):Line(`error(\`Unexpected enum: \{Index\}\`)`):End()
		end

		Write:Line(`{Write:Declare("EnumIndex")} = {WriteTable}[{Variable}]`)
		Write:Compare("EnumIndex", "nil", "Equals")
			:Line(`error(\`Unexpected enum: \{{Variable}\}, expected one of {Literal}.\`)`)
			:End()
		Types.u8.Write("EnumIndex", Write)
		return
	end

	--> Read body (a field needs no placeholder: every branch assigns it or errors)
	if not IsFieldAccess(Variable) then
		Read:Line(`{Read:Declare(Variable)} = true :: any`)
	end
	Types.u8.Read(`Index`, Read)
	Read = Read:Compare("Index", "0", "Equals")
	for Index, EnumItem in Enums do
		if Index > 1 then
			Read = Read:Branch("Conditional", "Index", `{Index - 1}`, "Equals")
		end

		Read:Line(`{Variable} = "{EnumItem}"`)
	end
	Read:Branch("Default"):Line(`error(\`Unexpected enum: \{Index\}\`)`):End()

	--> Write body
	local Allocation = Write:Allocate(1)
	for Index, EnumItem in Enums do
		if Index == 1 then
			Write = Write:Compare(Variable, `"{EnumItem}"`, "Equals")
		else
			Write = Write:Branch("Conditional", Variable, `"{EnumItem}"`, "Equals")
		end

		Write:Line(`buffer.writeu8(SendBuffer, {Allocation}, {Index - 1})`)
	end
	Write:Branch("Default"):Line(`error(\`Unexpected enum: \{{Variable}\}, expected one of {Literal}.\`)`):End()
end

function Declarations.Map(
	Declaration: Parser.Map,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string,
	Source: Source?
)
	local MapValue = Declaration.Value
	local Key = MapValue.Values[1]
	local Value = MapValue.Values[2]

	local KeyVariable = `Key_{Read.Indent}`
	local ElementVariable = `Element_{Write.Indent}`
	local ElementsVariable = `Elements_{Write.Indent}`
	local ElementsAllocation = Write:Allocate(2)

	local MapVariable = Variable
	local ElementSource: Source? = nil
	if Source then
		--> Reuse mode: the previous map, emptied; its values' tables become spares for the new ones
		if IsFieldAccess(Variable) then
			MapVariable = `Map_{Read.Indent}`
		end
		ReuseTable(Read, MapVariable, Source, "{}")
		if UsesSpares(Value :: Type) then
			local Spare = NewSpareList()
			Read:Line(`for _, Old in {MapVariable} do`)
			Read:Line(`table.insert({Spare}, Old)`, Read.Indent + 1)
			Read:Line("end")
			ElementSource = { Get = `table.remove({Spare}) :: any` }
		end
		Read:Line(`table.clear({MapVariable})`)
	else
		Read:Line(`{Read:Declare(Variable)} = \{\}`)
	end
	Write:Line(`local {ElementsVariable} = 0`)
	Types.u16.Read(ElementsVariable, Read)

	local ReadLoop = Read:Loop("_ = 1", ElementsVariable)
	local WriteLoop = Write:Iterator(KeyVariable, ElementVariable, Variable)

	--> Maps are unsafe
	ReadLoop:DisableOperationOptimisations()
	WriteLoop:DisableOperationOptimisations()

	--ReadLoop:Line(`local Key: {KeyType}, Element: {ValueType};`)
	WriteLoop:Line(`{ElementsVariable} += 1`)
	Generators.UserType(Key :: Type, ReadLoop, WriteLoop, KeyVariable)
	Generators.UserType(Value :: Type, ReadLoop, WriteLoop, ElementVariable, ElementSource)
	ReadLoop:Line(`{MapVariable}[{KeyVariable}] = {ElementVariable}`)

	WriteLoop:End()
	ReadLoop:End()

	Write:Line(`buffer.writeu16(SendBuffer, {ElementsAllocation}, {ElementsVariable})`)
end

function Declarations.Struct(
	Declaration: Parser.Struct,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string,
	Source: Source?,
	Guard: string?,
	TagKey: string?
)
	local Value = Declaration.Value

	--> A struct of plain fields is read into locals and built by one constructor holding the
	--> values (no placeholder writes). The reads are generated apart from the writes, which use
	--> the struct's fields.
	if Source == nil and TagKey == nil and IsFlatStruct(Declaration) then
		Read:Declare(Variable, true)
		local Scope = Read:Scope()
		local Entries = {}
		for Index, Field in Value.Values do
			local Name = Field.Name
			local Local = if IsValidIdentifier(Name) then `Field_{Name}` else `Field_{Index}`
			Generators.UserType(Field :: Type, Scope, Blocks.Block(), Local)
			table.insert(Entries, `{FormatKey(Name)} = {Local}`)
		end
		Scope:Line(`{Variable} = \{{table.concat(Entries, ", ")}\} :: any`)
		Scope:End()

		for _, Field in Value.Values do
			Generators.UserType(Field :: Type, Blocks.Block(), Write, `{Variable}{FormatIndex(Field.Name)}`)
		end
		return
	end

	--> Constant-valued constructor compiles to DUPTABLE: one allocation, keys pre-sized.
	--> Every placeholder is overwritten by the field reads below (a tagged enum variant's
	--> tag field by the enum).
	local Template = {}
	for _, Field in Value.Values do
		table.insert(Template, `{FormatKey(Field.Name)} = false`)
	end
	if TagKey then
		table.insert(Template, `{FormatKey(TagKey)} = false`)
	end
	local Constructor = `\{{table.concat(Template, ", ")}\} :: any`
	if Source then
		ReuseTable(Read, Variable, Source, Constructor, Guard)
	else
		Read:Line(`{Read:Declare(Variable)} = {Constructor}`)
	end

	for _, Field in Value.Values do
		local Name = Field.Name
		local FieldVariable = `{Variable}{FormatIndex(Name)}`
		--> Reuse mode: nested tables are decoded into the previous value's field in place
		local FieldSource = if Source and IsTableType(Field :: Type) then InPlace(FieldVariable) else nil
		Generators.UserType(Field :: Type, Read, Write, FieldVariable, FieldSource)
	end
end

function Declarations.Tuple(Declaration: Parser.Tuple, Read: Blocks.Block, Write: Blocks.Block, Slots: { string }?)
	for Index, Value in Declaration.Value.Values do
		local Variable = `Value{Index}`
		local Source: Source? = nil
		if Slots and IsTableType(Value :: Type) then
			local Slot = NewRootSlot()
			Source = { Get = Slot, Set = Slot }
			table.insert(Slots, Slot)
		end
		Generators.UserType(Value :: Type, Read, Write, Variable, Source)
	end
end

function Declarations.TagEnum(
	Declaration: Parser.TagEnum,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string,
	Source: Source?
)
	local Value = Declaration.Value
	local Values = Value.Values

	--> Body
	local Tag = Value.Tag
	local Header = `"{Values[1].Name}"`
	local TagIndex = `{Variable}{FormatIndex(Tag)}`

	Types.u8.Read(`Tag`, Read)
	if Source then
		--> Reuse mode: no placeholder, the variant's struct takes the previous table or a new one
		Read:Declare(Variable, true)
	else
		Read:Line(`{Read:Declare(Variable)} = true :: any`)
	end

	local Allocation = Write:Allocate(1)

	Read = Read:Compare("Tag", "0", "Equals")
	Write = Write:Compare(TagIndex, Header, "Equals")

	for Index, Variant in Values do
		local Name = `"{Variant.Name}"`
		if Index > 1 then
			Read = Read:Branch("Conditional", "Tag", tostring(Index - 1), "Equals")
			Write = Write:Branch("Conditional", TagIndex, Name, "Equals")
		end

		Write:_lineFront(`buffer.writeu8(SendBuffer, {Allocation}, {Index - 1})`)
		Write:Advance(1)

		--> Reuse mode: the previous table only serves a value of the same variant
		Declarations.Struct(Variant, Read, Write, Variable, Source, if Source then `{TagIndex} ~= {Name}` else nil, Tag)
		Read:Line(`{TagIndex} = {Name}`)
	end

	Read:Branch("Default"):Line(`error(\`Unexpected variant: \{Tag\}\`)`):End()

	Write:Branch("Default"):Line(`error(\`Unexpected variant: \{{TagIndex}\}\`)`):End()
end

function Declarations.Event(Declaration: Parser.Event)
	local Value = Declaration.Value
	local Name = Declaration.Name

	local Identifier = `EVENT_{Name}`
	local Reliability = Value.Type

	local IsReliable = (Reliability == "Reliable")
	local IsUnreliable = (Reliability == "Unreliable")
	local IsPolling = (Value.Call == "Polling" or Options.UsePolling)

	--> Two-way events ("From: Both") get both a sending and a listening side in every context
	local CanFire = (Value.From == Context or Value.From == "Both")
	local CanListen = (Value.From ~= Context or Value.From == "Both")

	local Channel = IsUnreliable and Channels.Unreliable or Channels.Reliable
	local HandlersTable = IsUnreliable and "UnreliableHandlers" or "ReliableHandlers"

	local Index = NextIndex(Channel)
	local Queue = `Queue.{Reliability}[{Index}]`
	local Connection = `Events.{Reliability}[{Index}]`
	--> The receive handlers find their listeners through a local alias of Events.<Channel>
	local ListenersLocal = `Events{Reliability}[{Index}]`

	--> ReuseReceiveTables / ReuseTables: listened (not polled) events may decode into the
	--> previous value's tables. ReuseSlots collects the slots holding this event's root tables.
	local Reuse = if Value.ReuseTables ~= nil then Value.ReuseTables else Options.ReuseReceiveTables == true
	local ReuseSlots: { string }? = if Reuse and CanListen and not IsPolling then {} else nil

	--> Data body
	local Types, Values, Arguments, _ = "nil", "Value: nil", "Value", nil
	local Read, Write = Generators.Event(Value.Data, Index, Identifier, nil, ReuseSlots)

	if Value.Data then
		Types, Values, _, Arguments = Generators.LuauType(Value.Data :: Type, true)
	end

	if CanFire then
		UserTypes.PushLines(Write, 1, 0)
	end

	--> Listened events read their data inline in the receive handler (one call less per event);
	--> only polled events keep a separate read function.
	if CanListen and IsPolling then
		UserTypes.PushLines(Read, 1, 0)
	end

	--> Return body
	local Body = Builder.new()
	local Indent = Util.GetScopeIndent(Scope)
	local ReadEvent = `{Util.GetPath(Identifier, false, Scope)}()`
	local PlayerParameter = Context == "Server" and "Player: Player" or ""
	local PlayerArgument = Context == "Server" and "Player, " or ""

	Body.Push(`{Name} = \{`, 0, Indent)
	Noop.Push(`{Name} = \{`, 0, Indent)

	local Members: { { string } } = {}
	local NoopMembers: { string } = {}

	if CanListen and not IsPolling then
		local IsSync = (Value.Call == "SingleSync" or Value.Call == "ManySync")
		local IsSingle = (Value.Call == "SingleSync" or Value.Call == "SingleAsync")

		if not IsSingle then
			Events.Push(`{Connection} = \{}`)
		end

		if IsReliable then
			Events.Push(`{Queue} = \{}`)
		end

		Channel.Listening = true
		if IsSync then
			Channel.Sync = true
		end

		local ContextArguments = `Listener: ({Context == "Server" and "Player: Player, " or ""}{Values}) -> ()`
		local ListenerArguments = `{PlayerArgument}{Arguments}`

		--> Reused tables must not be overwritten while something still holds them: a value that is
		--> queued (no listener yet) or held by an Async listener that yielded (its thread was not
		--> handed back, so FreeThread is nil) keeps its tables, the next event allocates new ones.
		local ReleaseTables: { string } = {}
		if ReuseSlots then
			for _, Slot in ReuseSlots do
				table.insert(ReleaseTables, `{Slot} = nil\n`)
			end
		end

		--> Listener invocation
		local CallListener = Blocks.Block()
		do
			if IsSync and Options.SyncValidation then
				CallListener = CallListener:Line(`SerdesEvent = "{Name}"`)
			end

			local PathExpr = "Listener"
			local CallExpr = IsSync and `{PathExpr}({ListenerArguments})` or `Spawn({PathExpr}, {ListenerArguments})`
			CallListener = CallListener:Line(CallExpr)
			if not IsSync and #ReleaseTables > 0 then
				CallListener = CallListener:Line("if FreeThread == nil then")
				CallListener:Lines(ReleaseTables, CallListener.Indent + 1)
				CallListener:Line("end")
			end
		end

		--> Server: a Sync listener runs inside the packet's xpcall. The flag tells its errors apart
		--> from decode errors, so a listener bug is reported as an error and the packet goes on.
		local GuardListener = IsSync and Context == "Server"
		local Rate = RateCheck(Value.Rate, Name)

		--> Receive handler, dispatched by event index
		local Handler = Blocks.Function(`{HandlersTable}[{Index}]`, PlayerParameter, nil, true)
		if Value.Data then
			--> The read function's body without its header, return and end
			assert(string.find(Read[#Read - 1], "^%s*return ") and string.find(Read[#Read], "^end"), "unexpected read body")
			--> A local lets native code keep the buffer in a register across the reads
			Handler:Line("local RecieveBuffer = RecieveBuffer")
			Handler:Lines(table.move(Read, 2, #Read - 2, 1, {}), 0)
		else
			Handler:Line("local Value = nil")
		end

		if Rate then
			Handler:Line(`if not {Rate} then return end`)
		end

		if IsSingle then
			Handler:Line(`local Listener = {ListenersLocal}`)
		end

		local Before = GuardListener and "ListenerRunning = true" or nil
		local After = GuardListener and "ListenerRunning = false" or nil

		if IsReliable then
			local ListenerBound: Blocks.Block
			if IsSingle then
				ListenerBound = Handler:Compare("Listener", "nil", "Not")
				if Before then
					ListenerBound:Line(Before)
				end
				ListenerBound:Lines(CallListener.Content, Handler.Indent + 1)
				if After then
					ListenerBound:Line(After)
				end
			else
				Handler:Line(`local Listeners = {ListenersLocal}`)
				ListenerBound = Handler:Compare(`#Listeners`, "0", "Greater")
				if Before then
					ListenerBound:Line(Before)
				end
				ListenerBound = ListenerBound
					:Iterator("_", "Listener", "Listeners")
					:Lines(CallListener.Content, Handler.Indent + 2)
					:End()
				if After then
					ListenerBound:Line(After)
				end
			end

			local Default = ListenerBound:Branch("Default")
			Default:Line(`QueueEvent({Queue}, "{Name}", {ListenerArguments})`)
			Default:Lines(ReleaseTables, Default.Indent)
			Default:End()
		else
			if IsSingle then
				local Bound = Handler:Compare("Listener", "nil", "Not")
				if Before then
					Bound:Line(Before)
				end
				Bound:Lines(CallListener.Content, Handler.Indent + 1)
				if After then
					Bound:Line(After)
				end
				Bound:End()
			else
				if Before then
					Handler:Line(Before)
				end
				Handler:Iterator("_", "Listener", ListenersLocal):Lines(CallListener.Content, Handler.Indent + 1):End()
				if After then
					Handler:Line(After)
				end
			end
		end

		Handler:End()
		HandlerLines.PushLines(Handler.Content, 0, 0)

		--> On: built by a shared factory, cast to this event's listener type
		local Factory = IsSingle and "ConnectSingle" or "ConnectMany"
		local Listener = Blocks.Block()
		Listener:Line(`{Casing.On} = {Factory}("{Reliability}", {Index}, {IsSync and "true" or "false"}) :: ({ContextArguments}) -> () -> ()`, 0)

		table.insert(Members, Listener:Wrap("", ",").Content)
		table.insert(NoopMembers, `{Casing.On} = NOOP,\n`)
	elseif CanListen and IsPolling then
		Events.Push(`{Queue} = CreateQueue()`)
		Channel.Listening = true

		local Handler = Blocks.Function(`{HandlersTable}[{Index}]`, PlayerParameter, nil, true)
		local Rate = RateCheck(Value.Rate, Name)
		if Rate then
			--> Read first: the event's bytes must be consumed even when it is dropped
			Handler:Line(`local Arguments = table.pack({PlayerArgument}{ReadEvent})`)
			Handler:Line(`if not {Rate} then return end`)
			Handler:Line(`Push({Queue}, Arguments)`)
		else
			Handler:Line(`Push({Queue}, table.pack({PlayerArgument}{ReadEvent}))`)
		end
		Handler:End()
		HandlerLines.PushLines(Handler.Content, 0, 0)

		local IterTypes = `number, {PlayerArgument ~= "" and "Player, " or ""}{Types}`

		local Next = Blocks.Function("", "", `({IterTypes})`)
			:Line("index += 1")
			:Line("local arguments = Pop(queue)")
			:Compare("arguments", "nil", "Not")
			:Return("index, unpack(arguments, 1, arguments.n)")
			:End()
			:Return("")
			:End()
			:Wrap("return ", "")

		local Deprecated = Blocks.Function(Casing.Next, "", `() -> ({IterTypes})`, true)
			:Line(`local index = 0`)
			:Line(`local queue = {Queue}`)
			:Lines(Next.Content, 1)
			:End()

		local Iter = Blocks.Function(Casing.Iter, "", `() -> ({IterTypes})`, true)
			:Line(`local index = 0`)
			:Line(`local queue = {Queue}`)
			:Lines(Next.Content, 1)
			:End()

		table.insert(Members, Iter:Wrap("", ",").Content)
		table.insert(Members, { "--- @deprecated v0.14.1 -- Use `Iter` instead.\n" })
		table.insert(Members, Deprecated:Wrap("", ",").Content)
		table.insert(NoopMembers, `{Casing.Iter} = NOOP,\n`)
		table.insert(NoopMembers, `{Casing.Next} = NOOP,\n`)
	end

	--> Fire functions are closures over the event's serializer, made by shared factories
	--> (see FIRE_FACTORIES): no function prototype per event and fire method.
	local Writer = Util.GetPath(Identifier, true, Scope)
	local IsSingleValue = (string.find(Arguments, ",", 1, true) == nil)
	local function FireFunction(FunctionName: string, Parameters: string, Factory: string?)
		local Expression = Writer
		if Factory then
			UsedFactories[Factory] = true
			Expression = `{Factory}({Writer})`
		end
		table.insert(Members, { `{FunctionName} = {Expression} :: ({Parameters}) -> (),\n` })
		table.insert(NoopMembers, `{FunctionName} = NOOP,\n`)
	end

	if CanFire and Context == "Client" then
		if IsReliable then
			--> The reliable outbox is always loaded on the client: Fire is the serializer itself
			FireFunction(Casing.Fire, Values)
		else
			FireFunction(Casing.Fire, Values, "UnreliableFire")
		end
	elseif CanFire and Context == "Server" then
		local PlayerValues = `Player: Player, {Values}`
		local ListValues = `List: \{Player\}, {Values}`
		local ExceptValues = `Except: Player, {Values}`

		if IsReliable then
			SendsReliable = true
			FireFunction(Casing.Fire, PlayerValues, IsSingleValue and "ReliableFire1" or "ReliableFire")
			FireFunction(Casing.FireAll, Values, IsSingleValue and "ReliableFireAll1" or "ReliableFireAll")
			FireFunction(Casing.FireList, ListValues, "ReliableFireList")
			FireFunction(Casing.FireExcept, ExceptValues, "ReliableFireExcept")
		else
			FireFunction(Casing.Fire, PlayerValues, "UnreliableFire")
			FireFunction(Casing.FireAll, Values, "UnreliableFireAll")
			FireFunction(Casing.FireList, ListValues, "UnreliableFireList")
			FireFunction(Casing.FireExcept, ExceptValues, "UnreliableFireExcept")
		end
	end

	for _, Member in Members do
		Body.PushLines(Member, 0, Indent + 1)
	end

	Noop.PushLines(NoopMembers, 0, Indent + 1)

	Channel.Count += 1

	Body.Push(`\},`, 0, Indent)
	Noop.Push(`\},`, 0, Indent)
	Return.PushLines(Body.DumpLines(), 0)
end

function Declarations.Function(Declaration: Parser.Function)
	local Name = Declaration.Name
	local Value = Declaration.Value

	local DataIdentifier = `FUNCTION_DATA_{Name}`
	local ReturnIdentifier = `FUNCTION_RETURN_{Name}`

	local Yield = Value.Yield
	local IsFuture = (Yield == "Future")
	local IsPromise = (Yield == "Promise")

	if IsFuture and not Options.FutureLibrary then
		error(`Cannot use yield type: "Future", without providing a path to the future library.`)
	end

	if IsPromise and not Options.PromiseLibrary then
		error(`Cannot use yield type: "Promise", without providing a path to the promise library.`)
	end

	local Channel = Channels.Reliable
	if Context == "Server" then
		--> Return values go back through the player's reliable writer
		SendsReliable = true
	end

	local Index = NextIndex(Channel)
	local Queue = `Queue.Reliable[{Index}]`
	local Connection = `Events.Reliable[{Index}]`

	--> Data and return body
	local DataTypes, DataValues, _, DataArguments = "nil", "Value: nil", nil, "Value"
	local ReturnTypes, ReturnValues, _, ReturnArguments = "nil", "ReturnValue: nil", nil, "ReturnValue"

	if Value.Data then
		DataTypes, DataValues, _, DataArguments = Generators.LuauType(Value.Data :: Type, true)
	end

	if Value.Return then
		ReturnTypes, ReturnValues, _, ReturnArguments = Generators.LuauType(Value.Return :: Type, true, "Return")
	end

	do
		local DataRead, DataWrite = Generators.Event(Value.Data :: Type, Index, DataIdentifier, "Data")
		local ReturnRead, ReturnWrite = Generators.Event(Value.Return :: Type, Index, ReturnIdentifier, "Return")

		if Context == "Client" then
			UserTypes.PushLines(DataWrite, 1, 0)
			UserTypes.PushLines(ReturnRead, 1, 0)
		elseif Context == "Server" then
			UserTypes.PushLines(DataRead, 1, 0)
			UserTypes.PushLines(ReturnWrite, 1, 0)
		end
	end

	--> Main
	local Body = Builder.new()
	local Indent = Util.GetScopeIndent(Scope)

	Noop.Push(`{Name} = \{`, 0, Indent)
	Body.Push(`{Name} = \{`, 0, Indent)

	--> Create queue and receive handler
	Events.Push(`{Queue} = \{\}`)
	Channel.Listening = true

	local Block = Blocks.Function(`ReliableHandlers[{Index}]`, Context == "Server" and "Player: Player" or "", nil, true)

	if Context == "Server" then
		--> Data recieve body
		Types.u8.Read("InvocationIdentifier", Block)
		Block:Line(`local {DataValues} = {Util.GetPath(DataIdentifier, false, Scope)}()`)

		--> Calls waiting for an answer hold a thread each: an honest client has at most 255
		Block:Line("local Budget = CurrentBudget")
		Block:Compare("Budget[4]", "256", "GreaterOrEquals")
			:Line(`error(\{"TooManyInvocations", "Function \\"{Name}\\""\})`)
			:End()
		local Rate = RateCheck(Value.Rate, Name)
		if Rate then
			--> Answer a call over its rate with an error, so the caller does not wait forever
			Block:Compare(Rate, "false", "Equals")
				:Line(`FailInvocation(Player, {Index}, InvocationIdentifier)`)
				:Return("")
				:End()
		end
		Block:Line("Budget[4] += 1")

		Block:Compare(Connection, "nil", "Not")
			:Line(`Spawn({Connection}, Player, {DataArguments}, InvocationIdentifier)`)
			:Branch("Default")
			:Compare(`#{Queue}`, "256", "Greater")
			:Line(`warn("[Current]: Event queue of \\"{Name}\\" exceeded 256, did you forget to implement a listener?")`)
			:End()
			:Compare(`#{Queue}`, "QUEUE_LIMIT", "GreaterOrEquals")
			:Line(`FailInvocation(Player, {Index}, InvocationIdentifier)`)
			:Line("Release(Player)")
			:Branch("Default")
			:Line(`table.insert({Queue}, \{Player, {DataArguments}, InvocationIdentifier\} :: \{any\})`)
			:End()
			:End()
		Block:End()
		HandlerLines.PushLines(Block.Content, 0, 0)

		--> Data listener body
		local FlushQueue = Blocks.Function("", "", "()")
			:Line(`local EventQueue = {Queue} or \{\}`)
			:Line(`{Queue} = nil`)
			:Iterator("Index", "Arguments", "EventQueue")
			:Line(`Spawn({Connection}, table.unpack(Arguments))`)
			:End()
			:End()
			:Wrap("task.spawn(", ")")

		local Serialize = Blocks.Function("", "")
			:Line(`{ReturnArguments} = Listener(Player, {DataArguments})`)
			:End()
			:Wrap("local Success, Error = pcall(", ")")

		local TrueListener =
			Blocks.Function(Connection, `Player: Player, {DataValues}, InvocationIdentifier: number`, "()", true)
				:Line(`local {ReturnValues};`)
				:Lines(Serialize.Content, 1)
				:Line("if Player ~= CurrentPlayer then UsePlayer(Player) end")
				:Compare("Success", "true", "Not")
				:Line(`local Position = Allocate({IndexBytes + 2})`)
				:Line(`buffer.write{IndexType}(SendBuffer, Position, {Index})`)
				:Line(`buffer.writeu8(SendBuffer, Position + {IndexBytes}, InvocationIdentifier)`)
				:Line(`buffer.writeu8(SendBuffer, Position + {IndexBytes + 1}, 0)`)
				:Line(`warn(\`"{Name}" encountered an error, \{Error\}\`)`)
				:Branch("Default")
				:Line(`{Util.GetPath(ReturnIdentifier, true, Scope)}({ReturnArguments}, InvocationIdentifier)`)
				:End()
				:Line("Release(Player)")
				:End()

		local Listener = Blocks.Function(Casing.On, `Listener: (Player, {DataTypes}) -> ({ReturnTypes})`, "()", true)
			:Lines(TrueListener.Content, 1)
			:Lines(FlushQueue.Content, 1)
			:End()

		Noop.Push(`{Casing.On} = NOOP`, 0, Indent + 1)
		Body.PushLines(Listener.Content, 0, 2)
	else
		--> Return recieve body
		local Deserialize = Blocks.Function("", "")
			:Return(`{Util.GetPath(ReturnIdentifier, false, Scope)}()`)
			:End()
			:Wrap(`local Success, {ReturnArguments} = pcall(`, ")")

		Types.u8.Read("InvocationIdentifier", Block)
		Block:Lines(Deserialize.Content, Block.Indent)
		Block:Line("local Thread = Calls[InvocationIdentifier]")
		Block:Compare("Thread", "nil", "Not")
			:Line("Calls[InvocationIdentifier] = nil")
			:Line(`task.spawn(Thread, Success, {ReturnArguments})`)
			:End()
		Block:End()
		HandlerLines.PushLines(Block.Content, 0, 0)

		--> Function listener body
		local Exhaust = Blocks
			.Block()
			:Compare("Calls[InvocationIdentifier]", "nil", "Not")
			--> Fail instead of closing/cancelling the thread
			:Line("Invocations -= 1")
			:Line('error("More than 256 calls are awaiting a response, this packet has been dropped.")')
			:End()
			.Content

		local Error = `"There was an exception while processing \\"{Name}\\"."`
		local Contents = Blocks.Block()
			:Line("local InvocationIdentifier = Invoke()")
			:Lines(Exhaust)
			:Line(`{Util.GetPath(DataIdentifier, true, Scope)}({DataArguments}, InvocationIdentifier)`)
			:Line("Calls[InvocationIdentifier] = coroutine.running()")
			:Line(`local Success, {ReturnValues} = coroutine.yield()`)
			:Compare("Success", "true", "Not")
			:Line(`error({Error})`)
			:End()
			:Return(ReturnArguments).Content

		local Invoke
		if IsFuture then
			local Wrapper = Blocks.Function("", ""):Lines(Contents):End():Wrap("return Future.Try(", ")")

			Invoke = Blocks.Function(Casing.Invoke, DataValues, `Future.Future<boolean, {ReturnTypes}>`, true)
			Invoke:Lines(Wrapper.Content, 1)
		elseif IsPromise then
			local OnCancel =
				Blocks.Function("", ""):Line("Calls[InvocationIdentifier] = nil"):End():Wrap("OnCancel(", ")")

			local Promise = Blocks.Function("", "Resolve, Reject, OnCancel")
				:Line("local InvocationIdentifier = Invoke()")
				:Lines(Exhaust)
				:Line(`{Util.GetPath(DataIdentifier, true, Scope)}({DataArguments}, InvocationIdentifier)`)
				:Line("Calls[InvocationIdentifier] = coroutine.running()")
				:Lines(OnCancel.Content, 1)
				:Line(`local Success, {ReturnValues} = coroutine.yield()`)
				:Compare("Success", "true", "Not")
				:Line(`Reject({Error})`)
				:Return("")
				:End()
				:Line(`Resolve({ReturnArguments})`)
				:End()
				:Wrap(`return Promise.new(`, ")")

			Invoke = Blocks.Function(Casing.Invoke, DataValues, nil, true)
			Invoke:Lines(Promise.Content, 1)
		else
			Invoke = Blocks.Function(Casing.Invoke, DataValues, `({ReturnTypes})`, true)
			Invoke:Lines(Contents, 0)
		end

		Invoke:End()
		Noop.Push(`{Casing.Invoke} = NOOP`, 0, Indent + 1)
		Body.PushLines(Invoke.Content, 0, Indent + 1)
	end

	Channel.Count += 1
	Channel.Listening = true

	Noop.Push(`\},`, 0, Indent)
	Body.Push(`\},`, 0, Indent)
	Return.PushLines(Body.DumpLines(), 0)
end

function Declarations.Array(
	Declaration: Parser.Array,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string,
	Source: Source?
)
	local Value = Declaration.Value
	local Of = Value.Of
	local Range = Value.Range :: NumberRange

	Read:Comment("START ARRAY")
	Write:Comment("START ARRAY")

	local Lower = Range.Min
	local Upper = Range.Max

	local Iterator = `Item_{Read.Indent}`
	local IsVariableSize = (Lower ~= Upper)

	--> Length
	if IsVariableSize then
		local LengthType = Prefabs.GetTypeToUse(Upper)
		LengthType.Read("Length", Read)
		local Assert = Prefabs.Asserts.integer("Length", Lower, Upper)

		--> The length is read unsigned: a lower bound of 0 needs no check
		if Lower > 0 then
			Read:Line(Assert.Lower)
		end
		Read:Line(Assert.Upper)
		if Prefabs.Strict.Sizes then
			--> Before table.create: a forged length must not make the server allocate a huge table
			local MinimumBytes = Prefabs.MinimumSize(Of)
			if MinimumBytes > 0 then
				Read:Line(`if Length * {MinimumBytes} > buffer.len(RecieveBuffer) - RecieveCursor then error("Array length exceeds the packet") end`)
			end
		end
		LengthType.Write(`#{Variable}`, Write)
	else
		Read:Line(`local Length = {Upper}`)
	end

	--> Array: a struct field is aliased by a local so the item stores do not index the struct again
	local ArrayVariable = Variable
	if IsFieldAccess(Variable) then
		ArrayVariable = `Array_{Read.Indent}`
	end

	local ItemSource: Source? = nil
	if Source then
		--> Reuse mode: the previous array, its items' tables decoded in place. A cut tail's tables
		--> become spares. Items that can be nil may leave holes, so such arrays are emptied instead.
		local ReadCounter = `Index_{Read.Indent}`
		ReuseTable(Read, ArrayVariable, Source, "table.create(Length)")
		if CanBeNil(Of) then
			Read:Line(`table.clear({ArrayVariable})`)
		elseif IsVariableSize then
			local Spare = if UsesSpares(Of) then NewSpareList() else nil
			Read:Line(`for {ReadCounter} = #{ArrayVariable}, Length + 1, -1 do`)
			if Spare then
				Read:Line(`table.insert({Spare}, {ArrayVariable}[{ReadCounter}])`, Read.Indent + 1)
			end
			Read:Line(`{ArrayVariable}[{ReadCounter}] = nil`, Read.Indent + 1)
			Read:Line("end")
			if IsTableType(Of) then
				local Item = `{ArrayVariable}[{ReadCounter}]`
				ItemSource = { Get = Item, Set = Item, Spare = Spare }
			end
		elseif IsTableType(Of) then
			local Item = `{ArrayVariable}[{ReadCounter}]`
			ItemSource = { Get = Item, Set = Item }
		end
	elseif ArrayVariable ~= Variable then
		Read:Line(`{Read:Declare(ArrayVariable)} = table.create(Length)`)
		Read:Line(`{Variable} = {ArrayVariable}`)
	else
		Read:Line(`{Read:Declare(Variable)} = table.create(Length)`)
	end

	--> Body
	local ReadCounter = `Index_{Read.Indent}`
	local WriteCounter = `Index_{Write.Indent}`
	Read = Read:Loop(`{ReadCounter} = 1`, "Length")
	Write = Write:Loop(`{WriteCounter} = 1`, IsVariableSize and `#{Variable}` or Upper)

	Write:Line(`local {Iterator} = {Variable}[{WriteCounter}]`)
	Generators.UserType(Of, Read, Write, Iterator, ItemSource)

	--> A recycled item table is already in place
	if ItemSource == nil then
		Read:Line(`{ArrayVariable}[{ReadCounter}] = {Iterator}`)
	end

	--> End
	Read = Read:End()
	Write = Write:End()

	Read:Comment("END ARRAY")
	Write:Comment("END ARRAY")
end

function Declarations.Optional(
	Declaration: Parser.Optional,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string,
	Source: Source?
)
	Read:Declare(Variable, true)

	local Of = Declaration.Value.Of
	local IsInstance = if Of.Type == "Primitive" then Of.Tokens.Primitive.Value == "Instance" else false

	if Source and not IsInstance then
		--> Reuse mode: a present value is decoded into the previous table, an absent one clears
		--> the field (a struct field keeps no table while it is nil)
		Types.u8.Write(`{Variable} ~= nil and 1 or 0`, Write)
		Read = Read:Compare(`buffer.readu8(RecieveBuffer, {Read:Read(1)})`, "1", "Equals")
		Write = Write:Compare(Variable, "nil", "Not")
		if IsFieldAccess(Variable) and UsesSpares(Of) then
			--> A struct field: its table becomes a spare while the field is nil
			local Spare = NewSpareList()
			Generators.UserType(Of, Read, Write, Variable, { Get = Variable, Set = Variable, Spare = Spare })
			Read = Read:Branch("Default")
			Read:Line(`if {Variable} then`)
			Read:Line(`table.insert({Spare}, {Variable})`, Read.Indent + 1)
			Read:Line("end")
			Read:Line(`{Variable} = nil`)
		else
			Generators.UserType(Of, Read, Write, Variable, Source)
			if IsFieldAccess(Variable) then
				Read = Read:Branch("Default")
				Read:Line(`{Variable} = nil`)
			end
		end
		Read:End()
		Write:End()
		return
	end

	if IsInstance then
		if string.find(Variable, "[%.%[]") then
			Read:Line(`{Variable} = nil`)
		end
		Read:Line("RecieveInstanceCursor += 1")
		Read = Read:Compare("typeof(RecieveInstances[RecieveInstanceCursor])", '"Instance"', "Equals")
		Read:Line("RecieveInstanceCursor -= 1")
	else
		if string.find(Variable, "[%.%[]") then
			Read:Line(`{Variable} = nil`)
		end
		Types.u8.Write(`{Variable} ~= nil and 1 or 0`, Write)
		Read = Read:Compare(`buffer.readu8(RecieveBuffer, {Read:Read(1)})`, "1", "Equals")
		Write = Write:Compare(Variable, "nil", "Not")
	end

	Generators.UserType(Declaration.Value.Of, Read, Write, Variable)
	Read:End()

	if not IsInstance then
		Write:End()
	end
end

--> Generator functions
--> Source (reuse mode only, table types only): where the previous value's table for this
--> value is found, see ReuseTable. Guard: an extra condition under which it is not reused.
function Generators.UserType(
	Declaration: Type,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string?,
	Source: Source?,
	Guard: string?
)
	local Name = Declaration.Name
	local Variable = Variable or "Value"

	if not _G.RELEASE then
		Read:Comment(`{Variable}: {Name}`)
		Write:Comment(`{Variable}: {Name}`)
	end

	if Declaration.Type == "Primitive" then
		local Kind = (Declaration :: Parser.Primitive).Tokens.Primitive.Value
		if Kind == "Instance" then
			Read:Line("RecieveInstanceCursor += 1")
		end

		Declarations.Primitive(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Set" then
		Declarations.Set(Declaration, Read, Write, Variable, Source)
	elseif Declaration.Type == "Map" then
		Declarations.Map(Declaration, Read, Write, Variable, Source)
	elseif Declaration.Type == "Enum" then
		Declarations.Enum(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Struct" then
		Declarations.Struct(Declaration, Read, Write, Variable, Source, Guard)
	elseif Declaration.Type == "Tuple" then
		Declarations.Tuple(Declaration, Read, Write)
	elseif Declaration.Type == "TagEnum" then
		Declarations.TagEnum(Declaration, Read, Write, Variable, Source)
	elseif Declaration.Type == "Array" then
		Declarations.Array(Declaration, Read, Write, Variable, Source)
	elseif Declaration.Type == "Optional" then
		Declarations.Optional(Declaration, Read, Write, Variable, Source)
	end
end

function Generators.LuauType(
	Declaration: Type,
	UseTypeAsValue: boolean?,
	Prefix: string?
): (string, string, string, string)
	Prefix = Prefix or ""

	local Type = "nil"
	local Values = "Value: nil"
	local Export = Util.GetExportName(Declaration.Name, Scope)
	local Returns = `{Prefix}Value`

	if Declaration.Type == "Primitive" then
		local Tokens = (Declaration :: Parser.Primitive).Tokens
		local Primitive = Primitives[Tokens.Primitive.Value]
		if type(Primitive.Type) == "function" then
			Type = Primitive.Type(Declaration :: Parser.Primitive)
		else
			Type = Primitive.Type
		end
	elseif Declaration.Type == "Set" then
		local Value = (Declaration :: Parser.Set).Value
		local Entries: { string } = {}

		for _, Flag in Value.Values do
			table.insert(Entries, `{FormatKey(Flag)}: boolean,`)
		end

		Type = `\{{table.concat(Entries)}\}`
	elseif Declaration.Type == "Enum" then
		local Value = (Declaration :: Parser.Enum).Value
		Type = `({Util.GenerateEnumLiterals(Value.Values)})`
	elseif Declaration.Type == "TagEnum" then
		local Value = (Declaration :: Parser.TagEnum).Value
		local Literals = {}

		for Index, Variant in Value.Values do
			local TagField = `{FormatKey(Value.Tag)}: "{Variant.Name}"`
			local ValueType = Generators.LuauType(Variant)
			table.insert(Literals, `\{ {TagField},{string.sub(ValueType, 2)}`)
		end

		Type = table.concat(Literals, " | ")
	elseif Declaration.Type == "Map" then
		local MapValue = (Declaration :: Parser.Map).Value
		local Key = Generators.LuauType(MapValue.Values[1])
		local Value = Generators.LuauType(MapValue.Values[2])
		Type = `\{[{Key}]: {Value}\}`
	elseif Declaration.Type == "Struct" then
		local Value = Declaration.Value
		local Fields = {}

		for _, Field in Value.Values do
			local Name = Field.Name
			local FieldType = Generators.LuauType(Field)
			table.insert(Fields, `{FormatKey(Name)}: {FieldType}`)
		end

		Type = `\{ {table.concat(Fields, ", ")}\ }`
	elseif Declaration.Type == "Generic" then
		Type = `{Declaration.Value.Generic}`
	elseif Declaration.Type == "Tuple" then
		local Value = (Declaration :: Parser.Tuple).Value

		local Types = { "nil" }
		local Variables = { "Value" }
		local AnnotatedVariables = { "Value: nil" }

		for Index, TupleValue in Value.Values do
			local Variable = `{Prefix}Value{Index}`
			local ValueType = Generators.LuauType(TupleValue)

			Types[Index] = ValueType
			Variables[Index] = Variable
			AnnotatedVariables[Index] = `{Variable}: {ValueType}`
		end

		Type = table.concat(Types, ", ")
		Values = table.concat(AnnotatedVariables, ", ")
		Returns = table.concat(Variables, ", ")
	elseif Declaration.Type == "Array" then
		local Value = Declaration.Value
		Type = `\{ {Generators.LuauType(Value.Of)} }`
	elseif Declaration.Type == "Optional" then
		local Value = Declaration.Value
		Type = `{Generators.LuauType(Value.Of)}?`
	end

	local Value = Declaration.Value

	if Value.Parameters then
		local Parameters = {}

		--> Generate luau types for parameters
		for Index, Parameter in Value.Parameters do
			local ParameterType = Generators.LuauType(Parameter)
			table.insert(Parameters, ParameterType)
		end

		--> Wrap in chevrons
		Type = `{Type}<{table.concat(Parameters, ",")}>`
	end

	--> Generalized type generation, works for everything except tuples
	if Declaration.Type ~= "Tuple" then
		Values = `{Prefix}Value: {UseTypeAsValue and Type or Export}`
	end

	return Type, Values, Export, Returns
end

function Generators.Type(Declaration: Type)
	local Value = Declaration.Value
	local Type, _, Export = Generators.LuauType(Declaration)

	local Generics = ""
	if Value.Generics then
		local Types = {}
		for _, Generic in Value.Generics.List do
			table.insert(Types, Generic)
		end

		Generics = `<{table.concat(Types, ",")}>`
	end

	--> Write luau export
	LuauTypes.PushMultiline(`export type {Export}{Generics} = {Type}`, 1, 0)
end

function Generators.Export(Declaration: Type)
	local Name = Declaration.Name
	local _, Values, Export, Returns = Generators.LuauType(Declaration)

	local Read = Blocks.Function(Casing.Read, "Buffer: buffer", `({Export})`, true)
	local Write = Blocks.Function(Casing.Write, `{Values}`, `(buffer)`, true)

	local Body = Builder.new()
	local Indent = Util.GetScopeIndent(Scope)
	Body.Push(`{Name} = \{`, 0, Indent)

	--> Overwrite buffer
	Read:Comment("Buffer overwrite")
	Write:Comment("Buffer overwrite")

	Read:Lines({
		"local PreviousCursor = RecieveCursor\n",
		"local PreviousBuffer = RecieveBuffer\n",
		"local PreviousInstanceCursor = RecieveInstanceCursor\n",
		"RecieveCursor = 0\n",
		"RecieveBuffer = Buffer\n",
	}, 1)

	Write:Lines({
		"BeginScratch()\n",
	}, 1)

	Read:Advance(#Read.Content - 1)
	Write:Advance(#Write.Content - 1)

	--> Write to buffer
	Read:Comment("Buffer read")
	Write:Comment("Buffer write")

	Generators.UserType(Declaration, Read, Write)

	--> Restore buffer
	Read:Comment("Buffer restore")
	Write:Comment("Buffer restore")

	Read:Lines({
		"RecieveCursor = PreviousCursor\n",
		"RecieveBuffer = PreviousBuffer\n",
		"RecieveInstanceCursor = PreviousInstanceCursor\n",
	}, 1)

	--> Trim buffer
	Write:Line("local Result = buffer.create(SendCursor)")
	Write:Line("buffer.copy(Result, 0, SendBuffer, 0, SendCursor)")

	Write:Line(`EndScratch()`)

	--> End export
	Read:Return(Returns)
	Write:Return("Result")

	Read:End():Wrap("", ",")
	Write:End()

	Body.PushLines(Read.Content, 0, Indent + 1)
	Body.PushLines(Write.Content, 0, Indent + 1)
	Body.Push(`\},`, 0, Indent)

	local BodyLines = Body.DumpLines()

	Noop.PushLines(table.clone(BodyLines), 0, 0)
	Return.PushLines(BodyLines, 0, 0)
end

--> ReuseSlots (events only): when given, the read reuses the previous value's tables and the
--> ReusedTables slots holding the root tables are appended to it.
function Generators.Event(
	Data: Type?,
	Index: number,
	Identifier: string,
	Function: ("Data" | "Return")?,
	ReuseSlots: { string }?
): ({ string }, { string })
	local Type, Values, _, Returns = "nil", "Value: nil", nil, "nil"
	if Data then
		Type, Values, _, Returns = Generators.LuauType(Data, true)
	end

	local Arguments = `{Values}{Function and ", InvocationIdentifier: number" or ""}`
	local Read = Blocks.Function(Util.GetPath(Identifier, false, Scope), "", `({Type})`)
	local Write = Blocks.Function(Util.GetPath(Identifier, true, Scope), Arguments, "()")

	if not _G.RELEASE then
		Write:Comment(`{Identifier} ({Index})`)
	end

	Types[IndexType].Write(Index, Write)
	if Function then
		Types.u8.Write("InvocationIdentifier", Write)
		if Function == "Return" then
			Types.u8.Write("1", Write)
			Types.u8.Read("Success", Read)
			Read:Compare("Success", "1", "Not"):Line('error("Server encountered an error.")'):End()
		end
	end

	if Data then
		if ReuseSlots and Data.Type == "Tuple" then
			Declarations.Tuple(Data :: Parser.Tuple, Read, Write, ReuseSlots)
		elseif ReuseSlots and IsTableType(Data) then
			local Slot = NewRootSlot()
			table.insert(ReuseSlots, Slot)
			Generators.UserType(Data, Read, Write, nil, { Get = Slot, Set = Slot })
		else
			Generators.UserType(Data, Read, Write)
		end
	end

	return Read:Return(Returns):End().Content, Write:End().Content
end

function Generators.Scope(Declaration: Parser.ScopeNode)
	local Name = Declaration.Name
	local Value = Declaration.Value

	local Parent = Scope
	local NewScope = Value.Scope

	local Path = Util.GetScopePrefix(NewScope, true, Scope)
	local Indent = (#string.split(Path, ".") - 1)
	Path = string.sub(Path, 1, #Path - 1)

	Scope = NewScope
	Noop.Push(`{Name} = \{`, 0, Indent)
	Return.Push(`{Name} = \{`, 0, Indent)

	Generators.AbstractSyntaxTree(Value.Values)

	Noop.Push(`},`, 0, Indent)
	Return.Push(`},`, 0, Indent)
	Scope = Parent
end

function Generators.AbstractSyntaxTree(Tree: { Parser.Declaration })
	for Index, Declaration in Tree do
		if Context == "Shared" and IGNORED_TYPES_IN_SHARED[Declaration.Type] then
			continue
		end

		if Declaration.Type == "Scope" then
			Generators.Scope(Declaration :: Parser.ScopeNode)
		elseif Declaration.Type == "Event" then
			Declarations.Event(Declaration :: Parser.Event)
		elseif Declaration.Type == "Function" then
			Declarations.Function(Declaration :: Parser.Function)
		else
			if Declaration.Value.Export then
				Generators.Export(Declaration :: Type)
			end

			Generators.Type(Declaration :: Type)
		end
	end
end

local function CountChannels(Tree: { Parser.Declaration }, Counts: { number }?): (number, number)
	local Counts = Counts or { 0, 0 }
	for _, Declaration in Tree do
		if Declaration.Type == "Scope" then
			CountChannels((Declaration :: Parser.ScopeNode).Value.Values, Counts)
		elseif Declaration.Type == "Event" then
			local Index = (Declaration :: Parser.Event).Value.Type == "Unreliable" and 2 or 1
			Counts[Index] += 1
		elseif Declaration.Type == "Function" then
			Counts[1] += 1
		end
	end
	return Counts[1], Counts[2]
end

--> Drops top-level local functions of the runtime templates that nothing else in the
--> module refers to (queue helpers without polling, listener threads without Async
--> listeners, unused send paths, ...), so a module only carries the code it can run.
--> A name that appears anywhere else, even in a comment or string, keeps its function.
local function Shake(Source: string): string
	local Lines = string.split(Source, "\n")
	local Chunks: { { Name: string, First: number, Last: number } } = {}

	local Index = 1
	while Index <= #Lines do
		local Line = Lines[Index]
		local Name = string.match(Line, "^local function ([%a_][%w_]*)%(")
		local Body = Index
		if Name == nil then
			local Declared = string.match(Line, "^local ([%a_][%w_]*)$")
			local Next = Lines[Index + 1]
			if Declared and Next and string.sub(Next, 1, #Declared + 12) == `{Declared} = function(` then
				Name = Declared
				Body = Index + 1
			end
		end

		if Name == nil then
			Index += 1
			continue
		end

		local Last = Body
		if not string.find(Lines[Body], "%f[%w_]end%s*$") then
			Last += 1
			while Last <= #Lines and Lines[Last] ~= "end" do
				Last += 1
			end
		end

		local First = Index
		while First > 1 and string.sub(Lines[First - 1], 1, 3) == "-->" do
			First -= 1
		end

		table.insert(Chunks, { Name = Name, First = First, Last = Last })
		Index = Last + 1
	end

	local function Count(Text: string, Name: string): number
		local Total = 0
		for _ in string.gmatch(Text, `%f[%w_]{Name}%f[^%w_]`) do
			Total += 1
		end
		return Total
	end

	local Dead: { [number]: boolean } = {}
	local Changed = true
	while Changed do
		Changed = false
		local Live = {}
		for Position, Line in Lines do
			if not Dead[Position] then
				table.insert(Live, Line)
			end
		end
		local Text = table.concat(Live, "\n")

		for _, Chunk in Chunks do
			if Dead[Chunk.First] then
				continue
			end
			local Own = Count(table.concat(Lines, "\n", Chunk.First, Chunk.Last), Chunk.Name)
			if Count(Text, Chunk.Name) == Own then
				for Position = Chunk.First, Chunk.Last do
					Dead[Position] = true
				end
				Changed = true
			end
		end
	end

	local Kept = {}
	for Position, Line in Lines do
		if not Dead[Position] then
			table.insert(Kept, Line)
		end
	end
	return table.concat(Kept, "\n")
end

--> The protected per-packet decode loop of the server, and the limits it enforces. Generated
--> rather than templated because the index width depends on the schema.
local function GenerateServerReceive(): { string }
	return {
		"--> Decodes and dispatches every event of the packet. Runs under the connection's xpcall.\n",
		"local function Dispatch(Player: Player, Handlers: {[number]: (Player) -> ()}, Size: number): (InvalidPacketReason?, string?)\n",
		"\twhile RecieveCursor < Size do\n",
		`\t\tlocal Index = buffer.read{IndexType}(RecieveBuffer, RecieveCursor)\n`,
		`\t\tRecieveCursor += {IndexBytes}\n`,
		"\t\tlocal Handler = Handlers[Index]\n",
		"\t\tif Handler == nil then\n",
		"\t\t\treturn \"UnknownEvent\", `Event index {Index}`\n",
		"\t\tend\n",
		"\t\tlocal Count = EventCount + 1\n",
		"\t\tEventCount = Count\n",
		"\t\tif Count > EventLimit then\n",
		"\t\t\tif Count > MAX_EVENTS_PER_PACKET then\n",
		"\t\t\t\treturn \"TooManyEvents\", `More than {MAX_EVENTS_PER_PACKET} events`\n",
		"\t\t\tend\n",
		"\t\t\treturn \"RateLimited\", \"Events per second\"\n",
		"\t\tend\n",
		"\t\tHandler(Player)\n",
		"\tend\n",
		"\treturn nil, nil\n",
		"end\n",
		"\n",
		"--> Each packet is decoded under one xpcall, made in its OnServerEvent connection. Recover handles\n",
		"--> the rest when that call failed or Dispatch returned a reason: a decode error drops the rest of\n",
		"--> the packet and reports it; a Sync listener's error is reported like any script error and the\n",
		"--> packet carries on with a new xpcall.\n",
		"local function Recover(Player: Player, Handlers: {[number]: (Player) -> ()}, Success: boolean, Result: any, Detail: any)\n",
		"\tlocal Size = buffer.len(RecieveBuffer)\n",
		"\twhile true do\n",
		"\t\tif Success then\n",
		"\t\t\tif Result ~= nil then\n",
		"\t\t\t\tInvalid(Player, Result, Detail)\n",
		"\t\t\tend\n",
		"\t\t\treturn\n",
		"\t\telseif ListenerRunning then\n",
		"\t\t\tListenerRunning = false\n",
		"\t\t\ttask.spawn(error, Result, 0)\n",
		"\t\telse\n",
		"\t\t\tif type(Result) == \"table\" then\n",
		"\t\t\t\tInvalid(Player, Result[1], Result[2])\n",
		"\t\t\telse\n",
		"\t\t\t\tInvalid(Player, \"Malformed\", tostring(Result))\n",
		"\t\t\tend\n",
		"\t\t\treturn\n",
		"\t\tend\n",
		"\t\tSuccess, Result, Detail = xpcall(Dispatch, Traceback, Player, Handlers, Size)\n",
		"\tend\n",
		"end\n",
		"\n",
		"--> Answers a client's function call with an error (over its Rate, or the queue is full)\n",
		"local function FailInvocation(Player: Player, Index: number, Invocation: number)\n",
		"\tif Player ~= CurrentPlayer then\n",
		"\t\tUsePlayer(Player)\n",
		"\tend\n",
		`\tlocal Position = Allocate({IndexBytes + 2})\n`,
		`\tbuffer.write{IndexType}(SendBuffer, Position, Index)\n`,
		`\tbuffer.writeu8(SendBuffer, Position + {IndexBytes}, Invocation)\n`,
		`\tbuffer.writeu8(SendBuffer, Position + {IndexBytes + 1}, 0)\n`,
		"end\n",
	}
end

--> Limit constants of the server module. 0 in the schema turns a limit off.
local LIMIT_DEFAULTS = {
	MaxPacketBytes = 16384,
	MaxPacketInstances = 256,
	MaxEventsPerPacket = 256,
	MaxBytesPerSecond = 65536,
	MaxEventsPerSecond = 1024,
}
--> Large but finite, so refill arithmetic never makes inf * 0 = NaN
local UNLIMITED = 2 ^ 50
local SERVER_QUEUE_LIMIT = 1024

local function GenerateLimits(): { string }
	local function Limit(Name: string): number
		local Value = (Options :: any)[Name]
		if Value == nil then
			Value = LIMIT_DEFAULTS[Name]
		end
		return if Value == 0 then UNLIMITED else Value
	end

	--> One second of the rate, but always room for one packet of the largest allowed size
	local function Burst(Rate: number, Packet: number): number
		if Rate >= UNLIMITED or Packet >= UNLIMITED then
			return Rate
		end
		return math.max(Rate, Packet)
	end

	local PacketBytes = Limit("MaxPacketBytes")
	local PacketEvents = Limit("MaxEventsPerPacket")
	local BytesPerSecond = Limit("MaxBytesPerSecond")
	local EventsPerSecond = Limit("MaxEventsPerSecond")
	return {
		`local MAX_PACKET_BYTES = {PacketBytes}\n`,
		`local MAX_PACKET_INSTANCES = {Limit("MaxPacketInstances")}\n`,
		`local MAX_EVENTS_PER_PACKET = {PacketEvents}\n`,
		`local BYTES_PER_SECOND = {BytesPerSecond}\n`,
		`local BYTES_BURST = {Burst(BytesPerSecond, PacketBytes)}\n`,
		`local EVENTS_PER_SECOND = {EventsPerSecond}\n`,
		`local EVENTS_BURST = {Burst(EventsPerSecond, PacketEvents)}\n`,
		--> What one instance reference costs against the byte budget
		"local INSTANCE_BYTES = 8\n",
	}
end

local Generator = {}

function Generator.Reset()
	--> Setup new builders
	Noop = Builder.new()
	Events = Builder.new()
	UserTypes = Builder.new()
	LuauTypes = Builder.new()
	Return = Builder.new()
	HandlerLines = Builder.new()
	Constants = Builder.new()
	EnumTables = {}
	EnumTableCount = 0
	UsedFactories = {}
	NextRateSlot = RATE_SLOT_START
	SendsReliable = false
	IndexType = "u8"
	IndexBytes = 1
	ReuseSlotCount = 0
	ReuseSpares = {}

	--> Reset channels
	Channels.Reliable.Count = 0
	Channels.Unreliable.Count = 0
	Channels.Reliable.Listening = false
	Channels.Unreliable.Listening = false
	Channels.Reliable.Sync = false
	Channels.Unreliable.Sync = false
	Channels.Reliable.Order = nil
	Channels.Unreliable.Order = nil
end

function Generator.Generate(FileContext: Context, AbstractSyntaxTree: Parser.Body): string
	local Imports = Builder.new()

	Generator.Reset()
	Context = FileContext
	Options = AbstractSyntaxTree.Value.Options
	Casing = Settings.GetCasing((Options.Casing :: Settings.Case) or "Pascal")

	--> Data from clients is hostile: the server's decoders check values the client's do not
	local IsServer = (Context == "Server")
	Prefabs.SetStrict(IsServer and Options.ValidateFloats ~= false, IsServer and Options.ValidateStrings ~= false, IsServer)

	--> Setup noop
	Noop.Push(`if not RunService:IsRunning() then`)
	Noop.Push(`local NOOP = function() end`, 0, 1)
	Noop.Push(`local Returns = table.freeze(\{`, 0, 1)

	--> Event indexes are u8, or u16 when a channel holds more than 256 events
	local ReliableCount, UnreliableCount = CountChannels(AbstractSyntaxTree.Value.Declarations)
	if math.max(ReliableCount, UnreliableCount) > 256 then
		IndexType = "u16"
		IndexBytes = 2
	end

	--> Shuffled wire indexes (on unless ShuffleEventIds = false). Client and server are made
	--> from the same tree, so both sides get the same permutation.
	if Options.ShuffleEventIds ~= false then
		local Hash = AbstractSyntaxTree.Value.Hash or 0
		local Seed = Options.EventIdSeed or ""
		Channels.Reliable.Order = ShuffleOrder(ReliableCount, Hash, Seed, "Reliable")
		Channels.Unreliable.Order = ShuffleOrder(UnreliableCount, Hash, Seed, "Unreliable")
	end

	--> Import async libraries
	if Options.FutureLibrary then
		Imports.Push(`local Future = require({Options.FutureLibrary})`)
	end

	if Options.PromiseLibrary then
		Imports.Push(`local Promise = require({Options.PromiseLibrary})`)
	end

	--> Replication
	local Replication = Builder.new()
	Return.Push(`{Casing.StepReplication} = StepReplication,`, 1, 1)
	if Context == "Server" then
		Return.Push(`{Casing.SetInvalidPacketHandler} = SetInvalidPacketHandler,`, 1, 1)
		Noop.Push(`{Casing.SetInvalidPacketHandler} = NOOP,`, 0, 2)
	end

	if not Options.ManualReplication then
		Replication.Push("RunService.Heartbeat:Connect(StepReplication)")
	end

	--> Parse declarations
	Generators.AbstractSyntaxTree(AbstractSyntaxTree.Value.Declarations)

	--> Generate context source
	local Source = Sources[Context]
	local Runtime = Source[2]
	local Sections = string.split(Runtime, RELIABLE_MARKER)
	if #Sections == 3 then
		Runtime = Sections[1] .. (if SendsReliable then Sections[2] else "local function StepReplication() end\n") .. Sections[3]
	end

	--> Receive connections: read the event index, then jump straight to its handler
	local Connections = {}
	local ServerHelpers = {}
	if Context == "Server" then
		ServerHelpers = GenerateServerReceive()
	end
	for _, Channel in { "Reliable", "Unreliable" } do
		if Context == "Server" then
			--> Hostile input: admit, then decode under protection (see Templates/Server SECURITY)
			table.insert(Connections, `{Channel}.OnServerEvent:Connect(function(Player: Player, Buffer: buffer, Instances: \{Instance\}?)\n`)
			table.insert(Connections, "\tlocal Budget = Admit(Player, Buffer, Instances)\n")
			table.insert(Connections, "\tif Budget == nil then\n\t\treturn\n\tend\n")
			table.insert(Connections, "\tRecieveCursor = 0\n")
			table.insert(Connections, "\tRecieveBuffer = Buffer\n")
			table.insert(Connections, "\tRecieveInstances = Instances or NoInstances\n")
			table.insert(Connections, "\tRecieveInstanceCursor = 0\n")
			--> Same yield validation as the client (see EVENT_SYNC_VALIDATION)
			local Validate = Options.SyncValidation and Channels[Channel].Sync
			if Options.SyncValidation and (Channels.Reliable.Sync or Channels.Unreliable.Sync) then
				for Line = 1, #EVENT_SYNC_VALIDATION - 1 do
					table.insert(Connections, `\t{EVENT_SYNC_VALIDATION[Line]}`)
				end
			end
			if Validate then
				table.insert(Connections, `\t{EVENT_SYNC_VALIDATION[#EVENT_SYNC_VALIDATION]}`)
			end
			table.insert(Connections, `\tlocal Success, Result, Detail = xpcall(Dispatch, Traceback, Player, {Channel}Handlers, buffer.len(Buffer))\n`)
			table.insert(Connections, `\tif not Success or Result ~= nil then\n`)
			table.insert(Connections, `\t\tRecover(Player, {Channel}Handlers, Success, Result, Detail)\n`)
			table.insert(Connections, `\tend\n`)
			--> Every packet costs at least one event token, so empty packets cannot flood for free
			table.insert(Connections, `\tBudget[2] -= math.max(EventCount, 1)\n`)
			if Validate then
				table.insert(Connections, `\tSerdesThread = nil\n`)
			end
			table.insert(Connections, `end)\n`)
			continue
		end

		local Signal = Context == "Client" and "OnClientEvent" or "OnServerEvent"
		local PlayerParameter = Context == "Server" and "Player: Player, " or ""
		local PlayerArgument = Context == "Server" and "Player" or ""
		table.insert(Connections, `{Channel}.{Signal}:Connect(function({PlayerParameter}Buffer: buffer, Instances: \{Instance\}?)\n`)
		for _, Line in EVENT_BODY do
			table.insert(Connections, `\t{Line}`)
		end
		--> Every channel closes a thread left suspended by a Sync listener (it would resume
		--> mid-packet), but only channels with Sync listeners pay for coroutine.running()
		local Validate = Options.SyncValidation and Channels[Channel].Sync
		if Options.SyncValidation and (Channels.Reliable.Sync or Channels.Unreliable.Sync) then
			for Line = 1, #EVENT_SYNC_VALIDATION - 1 do
				table.insert(Connections, `\t{EVENT_SYNC_VALIDATION[Line]}`)
			end
		end
		if Validate then
			table.insert(Connections, `\t{EVENT_SYNC_VALIDATION[#EVENT_SYNC_VALIDATION]}`)
		end
		table.insert(Connections, `\tlocal Handlers = {Channel}Handlers\n`)
		table.insert(Connections, `\twhile RecieveCursor < Size do\n`)
		table.insert(Connections, `\t\tlocal Index = buffer.read{IndexType}(RecieveBuffer, RecieveCursor)\n`)
		table.insert(Connections, `\t\tRecieveCursor += {IndexBytes}\n`)
		table.insert(Connections, `\t\tlocal Handler = Handlers[Index]\n`)
		table.insert(Connections, `\t\tif Handler == nil then\n`)
		table.insert(Connections, `\t\t\tbreak\n`)
		table.insert(Connections, `\t\tend\n`)
		table.insert(Connections, `\t\tHandler({PlayerArgument})\n`)
		table.insert(Connections, `\tend\n`)
		if Validate then
			table.insert(Connections, `\tSerdesThread = nil\n`)
		end
		table.insert(Connections, `end)\n`)
	end

	local Factories = {}
	for _, Name in FIRE_FACTORY_ORDER do
		if UsedFactories[Name] then
			table.insert(Factories, FIRE_FACTORIES[Context][Name])
		end
	end

	Noop.Push(`\})`, 0, 1)
	Noop.Push(`return Returns :: {EVENTS_TYPE}`, 0, 1)
	Noop.Push(`end`, 0, 0)

	Return.PushFront(`\nlocal Returns = table.freeze(\{`)
	Return.Push(`})`)

	local ScopeValidationBody = {}
	if Context ~= "Shared" then
		local RemoteScope = Options.RemoteScope or "CURRENT"
		ScopeValidationBody = {
			"_G._CURRENT = _G._CURRENT or {}\n",
			`if _G._CURRENT["{RemoteScope}"] then\n`,
			`\terror("[Current]: An instance of Current is already running with the remote scope \\"{RemoteScope}\\". Change the remote scope of either instance to avoid conflicts.")\n`,
			"end\n",
			`_G._CURRENT["{RemoteScope}"] = true\n`,
		}
	end

	local MergedOutput = Table.Merge(
		DIRECTIVES,
		VERSION_HEADER,
		ScopeValidationBody,
		string.split(Source[1], "\r"),
		Imports.DumpLines(),
		{ "local SerdesFunctions = {}\n" },
		{ `local BASE_EVENT_NAME = "{Options.RemoteScope and Options.RemoteScope .. "_" or ""}CURRENT"\n` },
		{ `local REUSE_SEND_BUFFERS = {Options.ReuseSendBuffers == true}\n` },
		--> Events queued before a listener connects: on the server clients fill them, so bounded
		{ `local QUEUE_LIMIT = {if Context == "Server" then SERVER_QUEUE_LIMIT else "math.huge"}\n` },
		(if Context == "Server" then GenerateLimits() else {}),
		string.split(Sources.Base, "\r"),
		(if Options.SyncValidation then SYNC_VALIDATION_BODY else {}),
		(if ReuseSlotCount > 0 then { `local {REUSED_TABLES}: \{[number]: any\} = \{\}\n` } else {}),
		ReuseSpares,
		{ "local EventsReliable, EventsUnreliable = Events.Reliable, Events.Unreliable\n" },
		Events.DumpLines(),
		LuauTypes.DumpLines(),
		{ "local EnumTables: {[number]: any} = {}\n", ENUM_TABLES_MARKER },
		UserTypes.DumpLines(),
		Noop.DumpLines(),
		string.split(Runtime, "\r"),
		Replication.DumpLines(),
		ServerHelpers,
		HandlerLines.DumpLines(),
		Connections,
		Factories,
		Return.DumpLines(),
		{ `type {EVENTS_TYPE} = typeof(Returns)\n`, `return Returns :: {EVENTS_TYPE}` }
	)

	--> Enum lookup tables are made for both directions; keep only the ones this side uses
	local Output = table.concat(MergedOutput)
	local Used = {}
	for _, Line in Constants.DumpLines() do
		local Reference = string.match(Line, "^%s*(EnumTables%[%d+%])")
		if Reference == nil or string.find(Output, Reference, 1, true) then
			table.insert(Used, Line)
		end
	end
	local MarkerStart, MarkerEnd = string.find(Output, ENUM_TABLES_MARKER, 1, true)
	Output = string.sub(Output, 1, (MarkerStart :: number) - 1) .. table.concat(Used) .. string.sub(Output, (MarkerEnd :: number) + 1)

	return Shake(Output)
end

function Generator.GenerateShared(AbstractSyntaxTree: Parser.Body): string
	Generator.Reset()
	Context = "Shared"
	Options = AbstractSyntaxTree.Value.Options
	Prefabs.SetStrict(false, false, false)
	Casing = Settings.GetCasing((Options.Casing :: Settings.Case) or "Pascal")

	--> Parse declarations
	Generators.AbstractSyntaxTree(AbstractSyntaxTree.Value.Declarations)

	--> Generate context source
	local Source = Sources[Context]
	local MergedOutput = Table.Merge(
		DIRECTIVES,
		VERSION_HEADER,
		string.split(Source[1], "\r"),
		{ `local REUSE_SEND_BUFFERS = {Options.ReuseSendBuffers == true}\n` },
		{ "local QUEUE_LIMIT = math.huge\n" },
		string.split(Sources.Base, "\r"),
		LuauTypes.DumpLines(),
		{ "\n" },
		{ "local EnumTables: {[number]: any} = {}\n" },
		Constants.DumpLines(),
		UserTypes.DumpLines(),
		string.split(Source[2], "\r"),
		{ "\n" },
		{ `\nreturn \{\n` },
		Return.DumpLines(),
		{ "\n}" }
	)

	return table.concat(MergedOutput)
end

function Generator.GenerateTypescript(FileContext: Context, AbstractSyntaxTree: Parser.Body): string
	return GenerateTypescript(FileContext, AbstractSyntaxTree)
end

return Generator
